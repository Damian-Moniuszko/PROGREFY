generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int               @id @default(autoincrement())
  email          String            @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           UserRole
  avatarUrl      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  phone          String?
  gender         String?
  clientProfile  ClientProfile?
  favorites      FavoriteTrainer[]
  trainerProfile TrainerProfile?
}

model ClientProfile {
  id           Int           @id @default(autoincrement())
  userId       Int           @unique
  height       Float?
  weight       Float?
  goal         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews      Review[]
}

model TrainerProfile {
  id                 Int                 @id @default(autoincrement())
  userId             Int                 @unique
  bio                String?
  specialization     String?
  price              Decimal?            @db.Decimal(10, 2)
  durationMinutes    Int?
  location           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cancellationPolicy String?
  paymentPolicy      String?
  appointments       Appointment[]
  availability       Availability[]
  favoritedBy        FavoriteTrainer[]
  reviews            Review[]
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialLinks        TrainerSocialLink[]
}

model FavoriteTrainer {
  id        Int            @id @default(autoincrement())
  userId    Int
  trainerId Int
  createdAt DateTime       @default(now())
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trainerId])
  @@index([userId])
}

model TrainerSocialLink {
  id        Int            @id @default(autoincrement())
  trainerId Int
  platform  String
  url       String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([trainerId, platform])
}

model Availability {
  id        Int            @id @default(autoincrement())
  trainerId Int
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, dayOfWeek])
}

model Appointment {
  id        Int               @id @default(autoincrement())
  clientId  Int
  trainerId Int
  startAt   DateTime
  endAt     DateTime
  price     Decimal           @db.Decimal(10, 2)
  status    AppointmentStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  client    ClientProfile     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainer   TrainerProfile    @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  payment   Payment?
  review    Review?

  @@index([clientId, startAt])
  @@index([trainerId, startAt])
}

model Review {
  id            Int            @id @default(autoincrement())
  trainerId     Int
  clientId      Int
  appointmentId Int            @unique
  rating        Int
  comment       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client        ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainer       TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, createdAt])
}

model Payment {
  id                Int           @id @default(autoincrement())
  appointmentId     Int           @unique
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  provider          String        @default("TEST")
  providerPaymentId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  appointment       Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status])
}

enum UserRole {
  CLIENT
  TRAINER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
