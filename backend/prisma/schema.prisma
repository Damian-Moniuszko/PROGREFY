generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  TRAINER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  GOOGLE_PAY
  CASH
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  passwordHash String?
  hasPassword  Boolean @default(true)

  emailVerified              Boolean   @default(true)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?

  firstName String
  lastName  String

  phone     String?
  gender    String?
  birthDate DateTime?

  role UserRole

  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile  ClientProfile?
  trainerProfile TrainerProfile?

  favorites FavoriteTrainer[]

  oauthAccounts OAuthAccount[]
}

model OAuthAccount {
  id Int @id @default(autoincrement())

  userId Int

  provider          String
  providerAccountId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model ClientProfile {
  id     Int @id @default(autoincrement())
  userId Int @unique

  height Float?
  weight Float?
  goal   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  appointments Appointment[]
  reviews      Review[]

  workoutPlans    WorkoutPlan[]
  workoutSessions WorkoutSession[]
}

model TrainerProfile {
  id     Int @id @default(autoincrement())
  userId Int @unique

  bio            String?
  specialization String?

  price Decimal? @db.Decimal(10, 2)

  durationMinutes Int?

  location String?

  paymentPolicy      String?
  cancellationPolicy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  availability Availability[]

  appointments Appointment[]

  reviews Review[]

  socialLinks TrainerSocialLink[]

  favoritedBy FavoriteTrainer[]

  workoutPlans WorkoutPlan[]
}

model FavoriteTrainer {
  id Int @id @default(autoincrement())

  userId    Int
  trainerId Int

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([userId, trainerId])
  @@index([userId])
}

model TrainerSocialLink {
  id Int @id @default(autoincrement())

  trainerId Int

  platform String
  url      String

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([trainerId, platform])
}

model Availability {
  id Int @id @default(autoincrement())

  trainerId Int

  dayOfWeek DayOfWeek

  startTime String
  endTime   String

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainerId, dayOfWeek])
}

model Appointment {
  id Int @id @default(autoincrement())

  clientId  Int
  trainerId Int

  startAt DateTime
  endAt   DateTime

  price Decimal @db.Decimal(10, 2)

  status AppointmentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  payment Payment?

  review Review?

  @@index([clientId, startAt])
  @@index([trainerId, startAt])
}

model Review {
  id Int @id @default(autoincrement())

  trainerId Int
  clientId  Int

  appointmentId Int @unique

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([trainerId, createdAt])
}

model Payment {
  id Int @id @default(autoincrement())

  appointmentId Int @unique

  amount Decimal @db.Decimal(10, 2)

  status PaymentStatus @default(PENDING)

  method PaymentMethod @default(CARD)

  provider String @default("TEST")

  providerPaymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status])
}

model WorkoutPlan {
  id Int @id @default(autoincrement())

  clientId  Int
  trainerId Int?

  name        String
  description String?

  durationWeeks Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  trainer TrainerProfile? @relation(fields: [trainerId], references: [id])

  workouts Workout[]

  @@index([clientId])
}

model Workout {
  id Int @id @default(autoincrement())

  planId Int

  name      String
  dayOfWeek DayOfWeek?

  order Int @default(0)

  plan WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  exercises       WorkoutExercise[]
  workoutSessions WorkoutSession[]
}

model Exercise {
  id Int @id @default(autoincrement())

  name String

  muscleGroup String?

  description String?

  workouts     WorkoutExercise[]
  exerciseSets ExerciseSet[]
}

model WorkoutExercise {
  id Int @id @default(autoincrement())

  workoutId  Int
  exerciseId Int

  sets Int
  reps String

  order Int @default(0)

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  exercise Exercise @relation(fields: [exerciseId], references: [id])
}

model WorkoutSession {
  id Int @id @default(autoincrement())

  clientId  Int
  workoutId Int?

  startedAt  DateTime
  finishedAt DateTime?

  notes String?

  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  workout Workout? @relation(fields: [workoutId], references: [id])

  sets ExerciseSet[]
}

model ExerciseSet {
  id Int @id @default(autoincrement())

  sessionId  Int
  exerciseId Int

  weight    Float
  reps      Int
  setNumber Int

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  exercise Exercise @relation(fields: [exerciseId], references: [id])
}
